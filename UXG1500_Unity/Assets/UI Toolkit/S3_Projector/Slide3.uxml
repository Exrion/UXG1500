<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/S3_Projector_Styles.uss?fileID=7433441132597879392&amp;guid=baeadb7bc49816d40a42a66b0d13d511&amp;type=3#S3_Projector_Styles" />
    <ui:VisualElement name="Container" class="Container-White Container transition-base identifier-dark-bg">
        <ui:Label text="The Purpose" class="heading1 transition-base identifier-dark-header" />
        <ui:Label text="Why did we read these passages then?" class="heading2 transition-base identifier-dark-text" />
        <ui:Label text="The participants of the test were given a minute to read the passages. Afterwards, their opinion on how easy or hard it was to read, as well as their preference and visual fatigue level." class="body transition-base identifier-dark-text" style="-unity-text-align: upper-left;" />
        <ui:Label text="It was found at the conclusion of the experience that players were more comfortable with the Dark Mode of the passages than the Light Mode." class="body transition-base identifier-dark-text" style="-unity-text-align: upper-left;" />
        <ui:Label text="Other Studies" class="heading2 transition-base identifier-dark-text" />
        <ui:Label text="A study conducted in 2025 (Sengsoon &amp; Intaruk, 2025) also found that when given a game and book to read on an iPad in both dark and light mode, participants tended to prefer reading in Dark Mode interfaces more than Light Mode." class="body transition-base identifier-dark-text" style="-unity-text-align: upper-left;" />
        <ui:VisualElement class="image-container transition-base" style="transition-delay: 0.1s; padding-left: 0; padding-right: 0;">
            <ui:VisualElement class="image identifier-dark-image transition-base" style="background-image: url(&quot;project://database/Assets/src/core/art/darkandlight.png?fileID=2800000&amp;guid=031c318bf348d0a4e83dac30b12800dd&amp;type=3#darkandlight&quot;); background-color: rgba(0, 0, 0, 0.06); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
