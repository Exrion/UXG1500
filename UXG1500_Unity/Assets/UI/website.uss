:root {
    -unity-font-definition: resource("Fonts/Arial");
    color: #000000;
}

/* MAIN ROOT */
.blog-root {
    flex-direction: column;
    flex-grow: 1;
    background-color: #c0c0c0;
}

/* BROWSER WINDOW AREA (above taskbar) */
.browser-window {
    flex-direction: column;
    flex-grow: 1;
    background-color: #d4d4d4;
}

/* OS GREY TITLE BAR */
.os-title-bar {
    height: 18px;
    background-color: #3a3a3a;
    align-items: center;
    padding-left: 6px;
}

.os-title-text {
    font-size: 11px;
    color: #ffffff;
}

/* BLUE XP TITLE BAR */
.browser-title-bar {
    height: 30px;
    background-color: #0055b7;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 8px;
    padding-right: 6px;
}

.browser-title-text {
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 13px;
}

/* WINDOW BUTTONS */
.window-buttons {
    flex-direction: row;
}

.window-btn {
    width: 16px;
    height: 16px;
    border-width: 1px;
    border-color: #ffffff;
    background-color: #0a2c6a;
    margin-left: 3px;
}

.window-btn.close {
    background-color: #cf2c28;
}

/* NAV TABS */
.nav-tabs {
    height: 40px;
    background-color: #e5e5e5;
    flex-direction: row;
    align-items: flex-end;
    padding-left: 10px;
}

.nav-tab-button {
    min-height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #0055b7;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 12px;

    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.nav-tab-selected {
    background-color: #003b8a;
}

/* SEARCH ROW */
.search-row {
    height: 34px;
    background-color: #d0d0d0;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #999999;
}

.search-label {
    font-size: 12px;
    margin-right: 4px;
}

.search-dropdown {
    width: 110px;
    margin-right: 6px;
}

.search-input {
    flex-grow: 1;
    margin-right: 6px;
}

.search-button {
    width: 60px;
    font-size: 11px;
}

/* CONTENT AREA */
.scroll-area {
    flex-grow: 1;
    padding: 10px;
}

.content-wrapper {
    flex-direction: column;
}

/* LAYOUT: SIDEBAR + MAIN COLUMN */
.page-layout {
    flex-direction: row;
}

/* SIDEBAR OUTER */
.sidebar {
    width: 220px;
    flex-direction: column;
}

/* BLUE TOP CAP */
.sidebar-header {
    height: 40px;
    background-color: #004f9f;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    justify-content: center;
    padding-left: 10px;
}

.sidebar-header-title {
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 16px;
}

/* YELLOW BODY */
.sidebar-body {
    background-color: #fffcc6;
    padding-left: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-right: 6px;
}

/* SECTION TITLES & LINKS */
.sidebar-section-title {
    -unity-font-style: bold;
    font-size: 13px;
    color: #004f9f;
    margin-top: 8px;
    margin-bottom: 4px;
    text-decoration: underline;
}

.sidebar-link {
    font-size: 12px;
    color: #003f7f;
    margin-left: 10px;
    margin-bottom: 2px;
}

.sidebar-more-link {
    font-size: 12px;
    color: #003f7f;
    margin-left: 10px;
    margin-top: 2px;
}

/* MAIN COLUMN */
.main-column {
    flex-grow: 1;
    flex-direction: column;
    margin-left: 16px;
}

/* HERO CARD */
.hero-card {
    background-color: #ffffff;
    border-radius: 18px;
    padding: 12px;
    border-width: 1px;
    border-color: #888888;
}

.hero-image {
    height: 200px;
    background-color: #000000;
    border-radius: 14px;
    margin-bottom: 10px;
}

.hero-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #003f7f;
}

.hero-subtitle {
    font-size: 12px;
    color: #333333;
    margin-top: 4px;
}

/* POSTS SECTION */
.posts-section {
    flex-direction: column;
    margin-top: 16px;
}

/* POST BOXES */
.forum-post {
    background-color: #ffffff;
    border-radius: 16px;
    border-width: 2px;
    border-color: #5b92ce;
    padding: 14px;
    margin-bottom: 14px;
}

/* AUTHOR LINE */
.post-author {
    flex-direction: row;
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.author-name {
    color: #c00000;
}

.author-date {
    color: #003f7f;
}

/* POST BODY */
.post-body {
    font-size: 12px;
    color: #333333;
    white-space: pre-wrap;
}

/* CARD STRIP */
.card-strip {
    flex-direction: row;
    margin-top: 16px;
}

.info-card {
    flex-grow: 1;
    background-color: #ffffff;
    border-width: 1px;
    border-color: #cccccc;
    border-radius: 10px;
    padding: 10px;
    margin-right: 10px;
}

.info-card:last-child {
    margin-right: 0;
}

.card-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 4px;
}

.card-body {
    font-size: 11px;
    color: #333333;
}

.card-footer {
    font-size: 11px;
    color: #777777;
    margin-top: 6px;
}

/* TASKBAR */
.taskbar {
    height: 30px;
    background-color: #0055b7;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 10px;
}

.taskbar-start {
    width: 70px;
    height: 22px;
    background-color: #2a7c2a;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 12px;
}

.taskbar-window-label {
    flex-grow: 1;
    margin-left: 8px;
    color: #ffffff;
    font-size: 11px;
}

.taskbar-clock {
    font-size: 11px;
    color: #ffffff;
}

/* CARD STRIP */
.card-strip {
    flex-direction: row;
    flex-wrap: wrap;       /* ← key fix */
    gap: 12px;
    margin-top: 16px;
}

/* INDIVIDUAL CARDS */
.info-card {
    background-color: #ffffff;
    border-width: 1px;
    border-color: #cccccc;
    border-radius: 10px;
    padding: 10px;

    flex: 1 1 260px;       /* grow, shrink, basis */
    min-width: 260px;      /* prevents text overflow */
}

/* CARD TEXT FIX */
.info-card * {
    white-space: normal;
    overflow: visible;
}
